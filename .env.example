# Optional: leave unset to use PeerJS Cloud signaling. No game server is required.
# VITE_PEER_HOST=your-signaling.example.com
# VITE_PEER_PORT=443
# VITE_PEER_PATH=/
# VITE_PEER_SECURE=true

# Optional ICE overrides. Without this, PeerJS uses its bundled STUN and shared TURN entries.
# For restrictive networks, supply STUN + a managed TURN service configuration.
# Browser env values are public: use short-lived TURN credentials, never permanent secrets.
# VITE_ICE_SERVERS=[{"urls":"stun:stun.example.com:3478"},{"urls":"turn:relay.example.com:3478","username":"temporary-user","credential":"temporary-credential"}]
