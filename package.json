{
  "name": "moonlit-battle-garden",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "e2e": "playwright test",
    "balance": "vite-node scripts/balance.ts",
    "assets:check": "vite-node scripts/check-assets.ts",
    "e2e:online": "playwright test --config=playwright.online.config.ts"
  },
  "dependencies": {
    "peerjs": "^1.5.5",
    "phaser": "^4.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.5.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "peer": "^1.0.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vite-node": "^3.2.4",
    "vitest": "^4.1.12"
  }
}
